<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Google Accounts Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/google_accounts"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btn_check_accounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/check_accounts" />

        <TextView
            android:id="@+id/tv_google_accounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#f0f0f0"
            android:padding="8dp"
            android:textSize="14sp"
            android:minHeight="100dp" />

        <!-- FRP Status Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frp_status"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btn_check_frp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/check_frp" />

        <TextView
            android:id="@+id/tv_frp_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#f0f0f0"
            android:padding="8dp"
            android:textSize="14sp"
            android:minHeight="100dp" />

        <!-- Partitions Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/partitions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btn_check_partitions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/check_partitions" />

        <TextView
            android:id="@+id/tv_partitions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#f0f0f0"
            android:padding="8dp"
            android:textSize="14sp"
            android:minHeight="100dp" />

        <!-- Bootloader Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bootloader"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btn_check_bootloader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/check_bootloader" />

        <TextView
            android:id="@+id/tv_bootloader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#f0f0f0"
            android:padding="8dp"
            android:textSize="14sp"
            android:minHeight="100dp" />

        <!-- ADB Commands Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/adb_commands"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/et_command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_command"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_execute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/execute" />

        <TextView
            android:id="@+id/tv_command_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#f0f0f0"
            android:padding="8dp"
            android:textSize="14sp"
            android:minHeight="150dp" />

    </LinearLayout>
</ScrollView>
