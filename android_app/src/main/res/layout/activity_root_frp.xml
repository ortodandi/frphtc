<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Root + FRP Bypass"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnBypassFRP"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bypass FRP" />

    <Button
        android:id="@+id/btnRootDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Root Device" />
        
    <Button
        android:id="@+id/btnInstallSuperSU"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Install SuperSU" />
        
    <Button
        android:id="@+id/btnRemoveAccounts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Remove Google Accounts" />

    <TextView
        android:id="@+id/tvRootStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Status: Ready"
        android:textSize="16sp" />

</LinearLayout>